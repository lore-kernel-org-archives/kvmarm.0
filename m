-		val =3D __ ## reg ## _nMASK;				\
-		val |=3D (s | set);					\
-		val &=3D ~(c | clr);					\
-		write_sysreg_s(val, SYS_ ## reg);			\
+		s |=3D set;						\
+		c |=3D clr;						\
+		if (c || s) {						\
+			u64 val =3D __ ## reg ## _nMASK;			\
+			val |=3D s;					\
+			val &=3D ~c;					\
+			write_sysreg_s(val, SYS_ ## reg);		\
+		}							\
 	} while(0)
