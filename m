_vcpu *vcpu)
 		clr |=3D ~hfg & __ ## reg ## _nMASK; 			\
 	} while(0)
=20
-#define update_fgt_traps_cs(reg, clr, set)				\
+#define update_fgt_traps_cs(vcpu, reg, clr, set)			\
 	do {								\
 		struct kvm_cpu_context *hctxt =3D				\
 			&this_cpu_ptr(&kvm_host_data)->host_ctxt;	\
