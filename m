>  arch/arm64/kvm/vgic/vgic-v5.c        | 52 ++++++++++++++++++++++++++++
>  include/linux/irqchip/arm-gic-v5.h   | 10 ++++++
>  5 files changed, 112 insertions(+), 1 deletion(-)
>  create mode 100644 arch/arm64/kvm/vgic/vgic-v5-tables.c
