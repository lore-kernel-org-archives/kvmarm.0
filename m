> -					 start, size, phys, prot);
> -	}
> +	if (WARN_ON(!kvm_host_owns_hyp_mappings()))
> +		return -EINVAL;

How comes that this doesn't generate a warning on a GICv2 system when
we try and map the CPU interface via create_hyp_io_mappings()?

