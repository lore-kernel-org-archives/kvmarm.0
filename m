> +unlock:
> +	hyp_spin_unlock(&pkvm_pgd_lock);
> +	hyp_spin_unlock(&host_kvm.lock);
> +
> +	return ret;
> +}
> +
>  int __pkvm_mark_hyp(phys_addr_t start, phys_addr_t end)
>  {
>  	int ret;
