+++ b/arch/arm64/kvm/sys_regs.c
@@ -619,8 +619,6 @@ static bool trap_debug_regs(struct kvm_vcpu *vcpu,
 			    const struct sys_reg_desc *r)
 {
 	access_rw(vcpu, p, r);
-	if (p->is_write)
-
 	kvm_debug_set_guest_ownership(vcpu);
 	return true;
 }

